{
  "name": "LruCache - .NET 8",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/DotNet",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "hediet.vscode-drawio"
      ],
      "settings": {
        "dotnet.server.useOmnisharp": false,
        "dotnet.defaultSolution": "LruCache.sln",
        "editor.formatOnSave": true,
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csharp"
        }
      }
    }
  },
  "postCreateCommand": "dotnet restore && dotnet build && (dotnet test &)",
  "remoteUser": "vscode"
}